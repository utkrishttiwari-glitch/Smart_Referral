
model Hospital {
  id          Int      @id @default(autoincrement())
  name        String
  address     String?
  city        String
  state       String?
  latitude    Float
  longitude   Float
  phone       String?
  isActive    Boolean  @default(true)

  services    HospitalService[]
  beds        BedAvailability[]
  dataUpdates HospitalDataUpdate[]
  referrals   Referral[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  hospitals   HospitalService[]
  referrals   Referral[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model HospitalService {
  id          Int      @id @default(autoincrement())

  hospitalId  Int
  serviceId   Int

  isAvailable Boolean @default(true)
  capacity    Int?
  notes       String?

  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])

  updatedAt   DateTime @default(now())

  @@unique([hospitalId, serviceId])
}

model BedAvailability {
  id          Int      @id @default(autoincrement())

  hospitalId  Int
  bedType     String
  totalBeds   Int
  availableBeds Int

  hospital    Hospital @relation(fields: [hospitalId], references: [id])

  updatedAt   DateTime @default(now())

  @@unique([hospitalId, bedType])
}

model HospitalDataUpdate {
  id          Int      @id @default(autoincrement())

  hospitalId  Int

  source      String
  dataType    String
  updatedAt   DateTime @default(now())
  isVerified  Boolean  @default(false)

  hospital    Hospital @relation(fields: [hospitalId], references: [id])
}

model Referral {
  id                  Int      @id @default(autoincrement())

  patientName         String
  referringDoctorName String?

  requiredServiceId   Int
  destinationHospitalId Int

  status              String   @default("CREATED")
  urgency             String?

  reason              String?
  notes               String?

  requiredService     Service  @relation(fields: [requiredServiceId], references: [id])
  destinationHospital Hospital @relation(fields: [destinationHospitalId], references: [id])

  reports MedicalReport[]

  alerts PreArrivalAlert[]

  assignedMedicalStaffId Int?
assignedMedicalStaff   MedicalStaff? @relation(fields: [assignedMedicalStaffId], references: [id])
locationUpdates LocationUpdate[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())

  
}

model MedicalReport {
  id          Int      @id @default(autoincrement())
  referralId  Int
  fileName    String
  fileType    String
  fileSize    Int
  filePath    String
  uploadedAt  DateTime @default(now())

  referral    Referral @relation(fields: [referralId], references: [id])
}

model PreArrivalAlert {
  id          Int      @id @default(autoincrement())
  referralId  Int
  message     String
  status      String   @default("SENT")
  sentAt      DateTime @default(now())
  acknowledgedAt DateTime?

  referral    Referral @relation(fields: [referralId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model MedicalStaff {
  id              Int      @id @default(autoincrement())
  name            String
  role            String
  phone           String?
  licenseNumber   String?
  ambulanceNumber String?
  isAvailable     Boolean  @default(true)
  referrals Referral[]

  locationUpdates LocationUpdate[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
}

model LocationUpdate {
  id                Int      @id @default(autoincrement())
  referralId        Int
  medicalStaffId    Int
  latitude          Float
  longitude         Float
  recordedAt        DateTime @default(now())

  referral          Referral     @relation(fields: [referralId], references: [id])
  medicalStaff      MedicalStaff @relation(fields: [medicalStaffId], references: [id])

  createdAt         DateTime @default(now())

  @@index([referralId])
  @@index([medicalStaffId])
}